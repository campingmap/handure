{
  // ══════════════════════════════════════════════════════
  //  Cloudflare 배포 설정
  //
  //  이 파일은 건드리지 않아도 됩니다.
  // ══════════════════════════════════════════════════════
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handure",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",

  "observability": { "enabled": true },

  // 홈페이지 파일 (HTML·사진)
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // 공지사항 데이터베이스
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handure",
      "database_id": "38c9da9f-0531-4c6b-8325-d567fb2347c2"
    }
  ]
}
